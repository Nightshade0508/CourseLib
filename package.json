{
  "name": "parallel-text-library",
  "version": "1.0.0",
  "private": true,
  "description": "中英对照阅读库：上传 PDF/Word、粘贴文章或给一个网址，自动逐段翻译；标注、生词本、学习卡片、本地朗读，可登录账号在设备之间同步。",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:all": "node scripts/build.mjs --all",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "dev:all": "node scripts/build.mjs --all && node scripts/serve.mjs",
    "vendor:sdk": "node scripts/vendor-sdk.mjs",
    "vendor:mt": "node scripts/vendor-mt.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test",
    "dev:accounts": "node scripts/build.mjs && node scripts/serve.mjs --emulators",
    "emulators": "npx -y firebase-tools@15.36.0 emulators:start --only auth,firestore --project demo-ptl",
    "vendor:firebase": "node scripts/vendor-firebase.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "acorn": "^8.19.0",
    "eslint-scope": "^8.4.0",
    "globals": "^16.5.0"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "0.132.1",
    "@huggingface/transformers": "4.3.1",
    "esbuild": "0.25.10",
    "firebase": "^13.3.0"
  }
}
